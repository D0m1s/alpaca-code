    <file alias="32x32/apps/io.alpaca.rs.png">io.alpaca.rs-32.png</file>
    <file alias="48x48/apps/io.alpaca.rs.png">io.alpaca.rs-48.png</file>
    <file alias="64x64/apps/io.alpaca.rs.png">io.alpaca.rs-64.png</file>
    <file alias="128x128/apps/io.alpaca.rs.png">io.alpaca.rs-128.png</file>
    <file alias="256x256/apps/io.alpaca.rs.png">io.alpaca.rs-256.png</file>
  </gresource>
</gresources>