<?xml version="1.0" encoding="UTF-8"?>
<!-- palette from the Figma mockup ("Agentic App – Dark IDE"): lavender keywords,
     gold functions, orange strings, blue booleans; card surface #0d1017.
     Languages address styles as def:* (gtksource def.lang namespace); the bare
     aliases are kept so older callers stay colored. -->
<style-scheme id="alpaca-dark" _name="alpaca dark" version="1.0">
  <style name="text"         foreground="#e6e8ee" background="#0d1017"/>
  <style name="line-numbers" foreground="#5a6375" background="#0d1017"/>
  <style name="current-line" background="#111723"/>
  <style name="selection"    background="#1b3560"/>

  <style name="def:comment"          foreground="#5a6375" italic="true"/>
  <style name="def:shebang"          foreground="#5a6375" italic="true"/>
  <style name="def:note"             foreground="#5a6375" bold="true"/>
  <style name="def:warning"          foreground="#5a6375" bold="true"/>
  <style name="def:keyword"          foreground="#c3a6f7"/>
  <style name="def:preprocessor"     foreground="#f2d98b"/>
  <style name="def:operator"         foreground="#e6e8ee"/>
  <style name="def:declared-symbol"  foreground="#f2d98b"/>
  <style name="def:function"         foreground="#f2d98b"/>
  <style name="def:name"             foreground="#f2d98b"/>
  <style name="def:identifier"       foreground="#9cdcfe"/>
  <style name="def:symbol"           foreground="#9cdcfe"/>
  <style name="def:string"           foreground="#f0a36e"/>
  <style name="def:character"        foreground="#f0a36e"/>
  <style name="def:special-char"     foreground="#f0a36e"/>
  <style name="def:escape"           foreground="#f0a36e"/>
  <style name="def:constant"         foreground="#5aa9f8"/>
  <style name="def:special-constant" foreground="#5aa9f8"/>
  <style name="def:integer"          foreground="#f0a36e"/>
  <style name="def:decimal"          foreground="#f0a36e"/>
  <style name="def:floating-point"   foreground="#f0a36e"/>
  <style name="def:base-n-integer"   foreground="#f0a36e"/>
  <style name="def:number"           foreground="#f0a36e"/>
  <style name="def:types"            foreground="#4ec9b0"/>
  <style name="def:error"            foreground="#ef4444" background="#2b1418"/>

  <style name="comment"      foreground="#5a6375" italic="true"/>
  <style name="keyword"      foreground="#c3a6f7"/>
  <style name="string"       foreground="#f0a36e"/>
  <style name="number"       foreground="#f0a36e"/>
  <style name="boolean"      foreground="#5aa9f8"/>
  <style name="null-value"   foreground="#5aa9f8"/>
  <style name="special-constant" foreground="#5aa9f8"/>
  <style name="constant"     foreground="#5aa9f8"/>
  <style name="identifier"   foreground="#9cdcfe"/>
  <style name="escaped-char" foreground="#f0a36e"/>
  <style name="markup"       foreground="#f2d98b"/>
  <style name="heading"      foreground="#9cdcfe"/>
  <style name="symbol"       foreground="#9cdcfe"/>
  <style name="types"        foreground="#4ec9b0"/>
  <style name="function"     foreground="#f2d98b"/>
  <style name="error"        foreground="#ef4444"/>
</style-scheme>